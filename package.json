{
  "name": "scrutins",
  "scripts": {
    "fetch": "bun src/fetch.ts",
    "ingest": "bun src/ingest.ts",
    "refresh": "bun src/fetch.ts && bun src/ingest.ts",
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun run build",
    "web:start": "cd web && bun run start"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.4.3"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "glossaire-politique": "github:Peralban/glossaire-politique#v0.1.0",
    "hono": "^4.13.13"
  }
}
